{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workbuddy:common:tokens-contract:1.3.0",
  "title": "Theme token contract",
  "description": "Every token a theme block in common/tokens/tokens.css MUST define (spec §6, AGENTS.md §18.4). Not a runtime config schema — a completeness contract used by common/test/tokens.test.mjs and by a project's own theme-override lint.",
  "version": "1.3.0",
  "type": "object",
  "properties": {
    "themes": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string"
      },
      "default": [
        "light",
        "dark",
        "sky",
        "ocean",
        "presentation",
        "contrast"
      ]
    },
    "requiredTokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^--[a-z][a-z0-9-]*$"
      }
    },
    "aaPairs": {
      "type": "array",
      "description": "Foreground/background token pairs that MUST pass WCAG AA in every theme (spec §8.2 assertion 54).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "fg",
          "bg",
          "minRatio"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "fg": {
            "type": "string"
          },
          "bg": {
            "type": "string"
          },
          "minRatio": {
            "type": "number",
            "enum": [
              3,
              4.5
            ]
          }
        }
      }
    }
  },
  "required": [
    "themes",
    "requiredTokens",
    "aaPairs"
  ],
  "default": {
    "themes": [
      "light",
      "dark",
      "sky",
      "ocean",
      "presentation",
      "contrast"
    ],
    "requiredTokens": [
      "--bg",
      "--surface",
      "--surface2",
      "--surface3",
      "--border",
      "--line",
      "--text",
      "--text2",
      "--text3",
      "--muted",
      "--ink",
      "--chrome-bg",
      "--chrome-fg",
      "--chrome-border",
      "--nav-bg",
      "--nav-fg",
      "--nav-bg-active",
      "--nav-fg-active",
      "--nav-border",
      "--thead-bg",
      "--thead-fg",
      "--navy",
      "--accent",
      "--blue",
      "--link",
      "--soft",
      "--btn-bg",
      "--on-fill",
      "--green",
      "--amber",
      "--red",
      "--ok-bg",
      "--ok-fg",
      "--warn-bg",
      "--warn-fg",
      "--error-bg",
      "--error-fg",
      "--chart-1",
      "--chart-2",
      "--chart-3",
      "--chart-4",
      "--chart-5",
      "--chart-6",
      "--shadow",
      "--welcome-left-bg",
      "--welcome-left-fg",
      "--welcome-left-border",
      "--welcome-accent",
      "--accent-purple",
      "--badge-bg",
      "--status-amber2-bg",
      "--status-amber2-fg",
      "--status-neutral-bg",
      "--status-neutral-fg",
      "--status-neutral2-bg",
      "--status-neutral2-fg",
      "--status-purple-bg",
      "--status-purple-fg",
      "--pchip-blue-bg",
      "--pchip-blue-border",
      "--pchip-blue-ink",
      "--pchip-violet-bg",
      "--pchip-violet-border",
      "--pchip-violet-ink",
      "--pchip-green-bg",
      "--pchip-green-border",
      "--pchip-green-ink",
      "--pchip-neutral-bg",
      "--pchip-neutral-border",
      "--pchip-neutral-ink",
      "--ds-zebra",
      "--crosshair-faint",
      "--crosshair-medium",
      "--crosshair-strong"
    ],
    "aaPairs": [
      {
        "label": "Body text",
        "fg": "--text",
        "bg": "--surface",
        "minRatio": 4.5
      },
      {
        "label": "Secondary text",
        "fg": "--text2",
        "bg": "--surface",
        "minRatio": 4.5
      },
      {
        "label": "Link",
        "fg": "--link",
        "bg": "--surface",
        "minRatio": 4.5
      },
      {
        "label": "Accent / focus ring",
        "fg": "--accent",
        "bg": "--surface",
        "minRatio": 3
      },
      {
        "label": "Text on primary button",
        "fg": "--on-fill",
        "bg": "--btn-bg",
        "minRatio": 4.5
      },
      {
        "label": "Chrome text (title/status bar)",
        "fg": "--chrome-fg",
        "bg": "--chrome-bg",
        "minRatio": 4.5
      },
      {
        "label": "Nav text on nav rail",
        "fg": "--nav-fg",
        "bg": "--nav-bg",
        "minRatio": 4.5
      },
      {
        "label": "Nav text on active item",
        "fg": "--nav-fg-active",
        "bg": "--nav-bg-active",
        "minRatio": 4.5
      },
      {
        "label": "Table header text",
        "fg": "--thead-fg",
        "bg": "--thead-bg",
        "minRatio": 4.5
      },
      {
        "label": "OK chip",
        "fg": "--ok-fg",
        "bg": "--ok-bg",
        "minRatio": 4.5
      },
      {
        "label": "Warning chip",
        "fg": "--warn-fg",
        "bg": "--warn-bg",
        "minRatio": 4.5
      },
      {
        "label": "Error chip",
        "fg": "--error-fg",
        "bg": "--error-bg",
        "minRatio": 4.5
      },
      {
        "label": "Welcome guide text",
        "fg": "--welcome-left-fg",
        "bg": "--welcome-left-bg",
        "minRatio": 4.5
      },
      {
        "label": "Welcome accent heading",
        "fg": "--welcome-accent",
        "bg": "--welcome-left-bg",
        "minRatio": 3
      },
      {
        "label": "Status chip: amber-2 (routed/transferred family)",
        "fg": "--status-amber2-fg",
        "bg": "--status-amber2-bg",
        "minRatio": 4.5
      },
      {
        "label": "Status chip: neutral (unavailable family)",
        "fg": "--status-neutral-fg",
        "bg": "--status-neutral-bg",
        "minRatio": 4.5
      },
      {
        "label": "Status chip: neutral-2 (not-submitted family)",
        "fg": "--status-neutral2-fg",
        "bg": "--status-neutral2-bg",
        "minRatio": 4.5
      },
      {
        "label": "Status chip: purple (routing-error family)",
        "fg": "--status-purple-fg",
        "bg": "--status-purple-bg",
        "minRatio": 4.5
      },
      {
        "label": "Accent purple vs surface (border/accent use)",
        "fg": "--accent-purple",
        "bg": "--surface",
        "minRatio": 3
      },
      {
        "label": "Badge bg vs on-fill text",
        "fg": "--on-fill",
        "bg": "--badge-bg",
        "minRatio": 4.5
      },
      {
        "label": "pchip blue ink/bg",
        "fg": "--pchip-blue-ink",
        "bg": "--pchip-blue-bg",
        "minRatio": 4.5
      },
      {
        "label": "pchip violet ink/bg",
        "fg": "--pchip-violet-ink",
        "bg": "--pchip-violet-bg",
        "minRatio": 4.5
      },
      {
        "label": "pchip green ink/bg",
        "fg": "--pchip-green-ink",
        "bg": "--pchip-green-bg",
        "minRatio": 4.5
      },
      {
        "label": "pchip neutral ink/bg",
        "fg": "--pchip-neutral-ink",
        "bg": "--pchip-neutral-bg",
        "minRatio": 4.5
      },
      {
        "label": "Body text over crosshair faint tint",
        "fg": "--text",
        "bg": "--crosshair-faint",
        "minRatio": 4.5
      },
      {
        "label": "Body text over crosshair medium tint",
        "fg": "--text",
        "bg": "--crosshair-medium",
        "minRatio": 4.5
      },
      {
        "label": "Body text over crosshair strong tint",
        "fg": "--text",
        "bg": "--crosshair-strong",
        "minRatio": 4.5
      }
    ]
  }
}
