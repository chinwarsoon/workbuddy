{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workbuddy:common:welcome-config:1.4.0",
  "title": "Welcome configuration",
  "description": "Per-dashboard welcome configuration (UI spec §3.7.2 rev 1.113). Text comes from ui_help.json; file types come from the source contract.",
  "version": "1.4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "instruction",
    "files",
    "mode",
    "help"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Generic application label. No project code or title (§3.7.3)."
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "description": "One instruction sentence under the task heading in the right panel."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/file"
      },
      "maxItems": 6,
      "description": "One entry per required workbook, 1–6 (§3.7.2 rev 1.110). 1–3 render as one-line slots, 4–6 as two-column compact slots. Each dashboardTitle must be unique."
    },
    "mode": {
      "enum": [
        "auto",
        "confirm"
      ],
      "description": "auto when files has one entry; confirm when two or more (§3.7.6)."
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "default": [
        "Reading the workbook",
        "Checking the data",
        "Building the dashboard"
      ]
    },
    "help": {
      "type": "string",
      "minLength": 1
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Optional text overrides; keys listed in welcome.mjs DEFAULT_LABELS."
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "privacy": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        }
      }
    },
    "logo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^data:"
        },
        "alt": {
          "type": "string"
        }
      }
    },
    "successHoldMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "default": 1500,
      "description": "Success hold after a successful load, in ms (§3.7.7 rev 1.113). 0 skips the hold (tests)."
    },
    "doneDwellMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "default": 0,
      "description": "Dwell after the done step paints and before the dashboard opener runs, in ms (§3.7.7 rev 1.113). 0 keeps the two-frame behavior."
    },
    "description": {
      "type": "string",
      "description": "One or two sentences under the title in the left guide panel (§3.7.3 rev 1.111)."
    },
    "checks": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "'What the check looks for' list in the left panel. Name only checks the dashboard really runs (§3.7.3 rev 1.111)."
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        }
      },
      "description": "Optional brand text beside the logo in the top bar."
    },
    "themePicker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "themes"
      ],
      "properties": {
        "themes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "label",
              "dot"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "dot": {
                "type": "string"
              }
            }
          }
        },
        "current": {
          "type": "string"
        }
      },
      "description": "Optional top-bar theme switcher (AGENTS.md §18.4 rev 2026-11-28). The project supplies the theme list and current key; the module renders the menu and calls onThemeChange(key) — it never touches localStorage or document.documentElement itself."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "auto"
          }
        }
      },
      "then": {
        "properties": {
          "files": {
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "confirm"
          }
        }
      },
      "then": {
        "properties": {
          "files": {
            "minItems": 2
          }
        }
      }
    }
  ],
  "definitions": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "dashboardTitle"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string"
        },
        "dashboardTitle": {
          "type": "string",
          "description": "Expected Code-sheet Dashboard Title (§3.7.5)."
        }
      }
    }
  }
}
